# Neon Postgres connection string (lấy từ https://console.neon.tech)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# JWT secret để ký token đăng nhập admin (tạo chuỗi ngẫu nhiên dài)
JWT_SECRET=change_me_to_a_long_random_string

# Tài khoản admin mặc định khi chạy `npm run db:seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Zalo của shop để khách liên hệ mua hàng (số điện thoại không có +84, dùng 0xxxx)
# Trên Next.js, biến cho client phải có prefix NEXT_PUBLIC_.
# Ví dụ: NEXT_PUBLIC_ZALO_PHONE=0987654321
# Có thể đặt link đầy đủ qua NEXT_PUBLIC_ZALO_URL nếu dùng Zalo OA.
NEXT_PUBLIC_ZALO_PHONE=
NEXT_PUBLIC_ZALO_URL=

# Domain production (KHÔNG có dấu / cuối) — dùng cho canonical, OG, sitemap.
# Ví dụ: NEXT_PUBLIC_SITE_URL=https://pure.vn
# Trên Vercel: chỉ cần set NEXT_PUBLIC_SITE_URL — server (sitemap, fetcher)
# cũng sẽ đọc giá trị này, fallback sang VERCEL_URL nếu chưa set.
NEXT_PUBLIC_SITE_URL=

# AppotaPay payment gateway.
# Lấy PARTNER CODE / API KEY / SECRET KEY từ AppotaPay Partner Portal.
# Sandbox dùng https://gateway.dev.appotapay.com, production dùng https://gateway.appotapay.com.
APPOTAPAY_ENV=sandbox
APPOTAPAY_PARTNER_CODE=
APPOTAPAY_API_KEY=
APPOTAPAY_SECRET_KEY=
APPOTAPAY_LANGUAGE=vi
APPOTAPAY_GATEWAY_URL=
APPOTAPAY_ACCOUNT_REF_ID=

# Public absolute URLs AppotaPay gọi về. Để trống sẽ dùng NEXT_PUBLIC_SITE_URL.
# Khi test local, dùng URL public như ngrok/Vercel preview thay cho localhost.
APPOTAPAY_NOTIFY_URL=
APPOTAPAY_REDIRECT_URL=

# MoMo Merchant API official payment gateway.
# Lay Partner Code / Access Key / Secret Key tu MoMo for Business (M4B).
# Sandbox domain mac dinh: https://test-payment.momo.vn
# Production domain mac dinh: https://payment.momo.vn
MOMO_ENV=sandbox
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_LANG=vi
MOMO_GATEWAY_URL=
MOMO_STORE_NAME=
MOMO_STORE_ID=

# Public absolute URLs MoMo goi ve. De trong se dung NEXT_PUBLIC_SITE_URL.
# Khi test local, dung URL public nhu ngrok/Vercel preview thay cho localhost.
MOMO_IPN_URL=
MOMO_REDIRECT_URL=

# Manual QR fallback for testing MoMo/ZaloPay without merchant API keys.
# Put QR images under public/payments/ and reference them as /payments/momo-qr.png.
MOMO_QR_IMAGE_URL=
MOMO_RECEIVER_NAME=
MOMO_RECEIVER_ACCOUNT=
ZALOPAY_QR_IMAGE_URL=
ZALOPAY_RECEIVER_NAME=
ZALOPAY_RECEIVER_ACCOUNT=

# Bí mật bảo vệ endpoint /api/_warm (cron giữ DB warm). Để trống nếu chưa dùng.
WARM_SECRET=
